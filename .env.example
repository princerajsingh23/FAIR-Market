# FAIR MARKET — Environment Configuration Template
# Copy this file to .env before running locally or via Docker Compose.
# Never commit real production credentials or secret keys to version control.

# Database Configuration (PostgreSQL in production; SQLite fallback used automatically if unset)
POSTGRES_USER=fairmarket
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=fairmarket_db
DATABASE_URL=postgresql://fairmarket:change_me_in_production@localhost:5432/fairmarket_db
SQLITE_DB_PATH=./backend/app/data/fair_market.db

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEFAULT_THEME=midnight
VITE_DEFAULT_REGION=Chandigarh-Mohali-Kharar-Zirakpur
